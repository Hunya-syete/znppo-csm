# GEMINI_API_KEY: Required for Gemini AI API calls (if applicable).
# For local development, replace with your actual API key from Google AI Studio (https://aistudio.google.com/).
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The base URL where this applet is hosted.
# For local development, set this to http://localhost:3000
APP_URL="http://localhost:3000"

# Firebase Admin SDK credentials used by the Express API on Vercel.
FIREBASE_PROJECT_ID="your_firebase_project_id"
FIREBASE_CLIENT_EMAIL="your_firebase_client_email"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n"

# PORT: The port on which the Express server listens (default: 3000).
PORT=3000

# NODE_ENV: Application environment ('development' or 'production').
NODE_ENV="development"
